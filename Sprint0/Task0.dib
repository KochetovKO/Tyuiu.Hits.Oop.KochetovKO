#!markdown

Ниже в блоке (Code) решите задачу
Дан целочисленный массив numbers со следующими элементами { 5, 8, 1, 3, 9, 6, 7, 2 }, нужно выполнить следующие операции:

Найти минимальное и максимальное значения в массиве.
Найти сумму всех элементов массива.
Найти среднее арифметическое всех элементов массива.
Отсортировать массив в порядке возрастания.
Проверить, содержит ли массив определенное число.

#!csharp

using System.Linq;
int[] array = { 5, 8, 1, 3, 9, 6, 7, 2 };
int max = array.Max();
int min = array.Min();
Console.WriteLine($"Максимальное: {max}");
Console.WriteLine($"Минимальное: {min}");

#!csharp

using System.Linq;
int[] array = { 5, 8, 1, 3, 9, 6, 7, 2 };
int sum = array.Sum();
Console.WriteLine($"Сумма: {sum}")

#!csharp

using System.Linq;
int[] array = { 5, 8, 1, 3, 9, 6, 7, 2 };
int sum = array.Sum();
int length = array.Length;
int answer = sum / length;
Console.WriteLine($"Среднее арифметическое: {answer}")

#!csharp

using System.Linq;
int[] array = {5, 8, 1, 3, 9, 6, 7, 2};
Array.Sort(array);
Console.WriteLine($"Отсортированный массив: ");
for(int i = 0; i < array.Length; i++)
{
    Console.WriteLine(array[i]);
}

#!csharp

using System.Linq;
int[] array = {5, 8, 1, 3, 9, 6, 7, 2};
int index = Array.IndexOf(array, 3);
if (index != -1)
{
    Console.WriteLine("Элемент найден");
}
else
{
    Console.WriteLine("Элемент не найден");
}
